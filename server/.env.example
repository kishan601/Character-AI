PORT=3001
# Neon PostgreSQL Connection URL
# e.g., postgresql://username:password@ep-cool-fog-123456.us-east-2.aws.neon.tech/neondb?sslmode=require
DATABASE_URL="postgresql://username:password@ep-xyz.us-east-2.aws.neon.tech/neondb?sslmode=require"

# LM Studio Local Server API
LM_STUDIO_URL="http://127.0.0.1:1234/v1"

# Cloudinary Cloud Storage (Optional - keeps avatars & wallpapers synced across multiple PCs)
# Get from https://cloudinary.com/console (Free tier: 25GB storage)
CLOUDINARY_URL="cloudinary://<api_key>:<api_secret>@<cloud_name>"
# OR individual keys:
# CLOUDINARY_CLOUD_NAME=""
# CLOUDINARY_API_KEY=""
# CLOUDINARY_API_SECRET=""

